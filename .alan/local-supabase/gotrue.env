# Static GoTrue (auth server) configuration shared by the install and start
# steps. The database URL, migrations path and JWT secret are added by the
# scripts that source this file, because they live in the runtime directory.

export GOTRUE_DB_DRIVER=postgres
export GOTRUE_SITE_URL=http://127.0.0.1:3000
export GOTRUE_URI_ALLOW_LIST='*'
export GOTRUE_DISABLE_SIGNUP=false
export GOTRUE_EXTERNAL_EMAIL_ENABLED=true
export GOTRUE_MAILER_AUTOCONFIRM=true
export GOTRUE_PASSWORD_MIN_LENGTH=6
export GOTRUE_JWT_ADMIN_ROLES=service_role
export GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
export GOTRUE_JWT_EXP=3600
export GOTRUE_LOG_LEVEL=info
export API_HOST=127.0.0.1
export API_PORT=9999
export PORT=9999
export API_EXTERNAL_URL=http://127.0.0.1:54321/auth/v1
